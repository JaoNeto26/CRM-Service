generator client {
  provider = "prisma-client"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
}

model usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  criadoEm  DateTime @default(now())
  clientes  cliente[]
}

model cliente {
  id          String       @id @default(uuid())
  nome        String
  email       String?
  telefone    String?
  empresa     String?
  status      statusCliente @default(LEAD)
  responsavel usuario?      @relation(fields: [responsavelId], references: [id])
  responsavelId String?
  negociacoes negociacao[]
  criadoEm    DateTime      @default(now())
  atualizadoEm DateTime     @updatedAt
}

model negociacao {
  id          String   @id @default(uuid())
  titulo      String
  valor       Decimal  @default(0)
  etapa       EtapaNegociacao @default(PROSPECCAO)
  cliente     cliente  @relation(fields: [clienteId], references: [id])
  clienteId   String
  criadoEm    DateTime @default(now())
  fechadoEm   DateTime?
}

enum statusCliente {
  LEAD
  ATIVO
  INATIVO
}

enum EtapaNegociacao {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  FECHADO_GANHO
  FECHADO_PERDIDO
}
