generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  criadoEm  DateTime @default(now())
  clientes  Cliente[]
}

model Cliente {
  id          String       @id @default(uuid())
  nome        String
  email       String?
  telefone    String?
  empresa     String?
  status      StatusCliente @default(LEAD)
  responsavel Usuario?      @relation(fields: [responsavelId], references: [id])
  responsavelId String?
  negociacoes Negociacao[]
  criadoEm    DateTime      @default(now())
  atualizadoEm DateTime     @updatedAt
}

model Negociacao {
  id          String   @id @default(uuid())
  titulo      String
  valor       Decimal  @default(0)
  etapa       EtapaNegociacao @default(PROSPECCAO)
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  clienteId   String
  criadoEm    DateTime @default(now())
  fechadoEm   DateTime?
}

enum StatusCliente {
  LEAD
  ATIVO
  INATIVO
}

enum EtapaNegociacao {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  FECHADO_GANHO
  FECHADO_PERDIDO
}
