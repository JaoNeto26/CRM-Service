{
  "compilerOptions": {
    "target": "ES6",
    "moduleResolution": "bundler",
    "module": "esnext",
    "lib": ["ES6"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true    
  },
  "include": ["src/**/*", "src/index.ts"],
  "exclude": ["node_modules", "dist"]
}
