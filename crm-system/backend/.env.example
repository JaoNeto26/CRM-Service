# PostgreSQL
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm_database
POSTGRES_PORT=5433

# Environment
NODE_ENV=development

# JWT Secret (use a local value and never commit real secrets)
JWT_SECRET=change-this-secret-locally
# Backend
BACKEND_PORT=3001
DATABASE_URL="postgresql://crm_user:change-me@localhost:5433/crm_database?schema=public"
NODE_ENV=development
JWT_SECRET="change-this-secret"